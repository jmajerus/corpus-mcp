{
  "name": "corpus-mcp",
  "version": "0.2.0",
  "description": "MCP server for searching, reading, and citing Calibre book libraries",
  "scripts": {
    "build": "tsc -p packages/citekey/tsconfig.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p packages/citekey/tsconfig.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "index": "tsx src/cli.ts index",
    "serve": "tsx src/cli.ts serve",
    "deploy": "node --env-file-if-exists=.env tools/deploy.mjs",
    "tags:apply": "node --env-file-if-exists=.env tools/apply-tags.mjs"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@jmajerus/citekey": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.13",
    "mupdf": "^1.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "bin": {
    "corpus-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/citekey"
  ]
}
