# corpus-mcp's workstation settings for npm run deploy and npm run tags:apply.
# Copy to .env (gitignored) and fill in. The server's own settings live in
# /etc/corpus-mcp/env on its LXC (see deploy/corpus-mcp.env.example).

# The shared authoring login's password, for SSH and sudo on the LXCs.
AUTHORING_DEPLOY_PASSWORD=

# Hosts (defaults shown).
# CORPUS_DEPLOY_HOST=authoring@corpus-mcp.localdomain
# CORPUS_SOURCE_ADMIN_HOST=authoring@calibre-web.localdomain

# tags:apply: the corpus server and the Calibre library to write (defaults shown).
# CORPUS_URL=http://corpus-mcp.localdomain:8000
# CORPUS_TAG_LIBRARY=main

# A tag vocabulary file (corpus-vocabulary/1) that every deploy validates and
# installs; npm run deploy -- --vocabulary installs it alone.
# CORPUS_VOCABULARY_SOURCE=../concept-clusters/.concept-clusters/corpus-vocabulary.json
