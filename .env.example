# corpus-mcp's workstation settings for npm run deploy and npm run tags:apply.
# Copy to .env (gitignored) and fill in. The server's own settings live in
# /etc/corpus-mcp/env on its LXC (see deploy/corpus-mcp.env.example).

# The shared authoring login's password, for SSH and sudo on the LXCs.
AUTHORING_DEPLOY_PASSWORD=

# Hosts (defaults shown).
# CORPUS_DEPLOY_HOST=authoring@corpus-mcp.localdomain
# CORPUS_SOURCE_ADMIN_HOST=authoring@calibre-web.localdomain

# tags:apply: the corpus server and the Calibre library to write (defaults shown).
# CORPUS_URL=http://corpus-mcp.localdomain:8000
# CORPUS_TAG_LIBRARY=main

# A tag vocabulary file (corpus-vocabulary/1) that every deploy validates and
# installs; npm run deploy -- --vocabulary installs it alone.
# CORPUS_VOCABULARY_SOURCE=../concept-clusters/.concept-clusters/corpus-vocabulary.json

# Zotero: npm run deploy -- --zotero copies these to the server. Make a key with
# read-only library access at https://www.zotero.org/settings/keys (the page shows
# your user id). An empty key turns the mirror off.
# CORPUS_ZOTERO_LIBRARY=users/1234567
# CORPUS_ZOTERO_API_KEY=
# CORPUS_ZOTERO_INTERVAL_MINUTES=30

# The vocabulary intake's service token, copied to the server by every deploy: the client id of the
# Access service token the vocabulary's owner pushes with, and the audience (AUD) tag of the Access
# application that covers only /api/intake/vocabulary. Neither is a secret.
# CORPUS_VOCABULARY_PUSH_CLIENT_ID=
# CORPUS_VOCABULARY_PUSH_AUD=

# The public catalogue's D1 proxy (docs/public-site.md), copied to the server by every deploy. The
# token is the proxy's D1_PROXY_TOKEN secret; it can run any SQL on the public replica.
# CORPUS_D1_PROXY_URL=https://corpus-mcp-d1-proxy.example.workers.dev
# CORPUS_D1_PROXY_TOKEN=

# Optional: a Cloudflare API token for npm run worker:deploy; without one, wrangler uses its own login.
# CLOUDFLARE_API_TOKEN=

# Who changes made directly on the LAN are recorded as (default "LAN"), copied to the server by every
# deploy; CORPUS_LAN_EDITS=off makes direct LAN access read-only (docs/operations.md, Access).
# CORPUS_LAN_ACTOR=you@example.com
# CORPUS_LAN_EDITS=on

# User-facing Cloudflare Access applications (also set in /etc/corpus-mcp/env on the host).
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_MCP_AUD=
# ACCESS_ADMIN_AUD=
