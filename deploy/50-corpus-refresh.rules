// Lets the corpus service user start corpus-refresh.service (the dashboard's "Refresh now"), and nothing else.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") === "corpus-refresh.service" &&
      action.lookup("verb") === "start" &&
      subject.user === "corpus") {
    return polkit.Result.YES;
  }
});
