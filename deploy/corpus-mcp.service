[Unit]
Description=corpus-mcp MCP server (Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
User=corpus
Group=corpus
EnvironmentFile=/etc/corpus-mcp/env
WorkingDirectory=/opt/corpus-mcp/current
ExecStart=/usr/bin/node /opt/corpus-mcp/current/dist/cli.js serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
# SQLite writes temporary files (large deletes, sorts); strict makes the shared /tmp read-only.
PrivateTmp=yes
ReadOnlyPaths=/srv/corpus/books
ReadWritePaths=/var/lib/corpus-mcp

[Install]
WantedBy=multi-user.target
