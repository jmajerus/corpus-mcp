[Unit]
Description=corpus-mcp: pull the Calibre libraries and update the index
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=corpus
Group=corpus
EnvironmentFile=/etc/corpus-mcp/env
WorkingDirectory=/opt/corpus-mcp/current
# A failed pull (for example, calibre-web.localdomain is down) still indexes whatever is on disk.
ExecStart=-/opt/corpus-mcp/current/deploy/corpus-sync.sh
ExecStart=/usr/bin/node /opt/corpus-mcp/current/dist/cli.js index
# The dashboard streams this file while a refresh runs (deploy/corpus-mcp.logrotate rotates it).
StandardOutput=append:/var/lib/corpus-mcp/refresh.log
StandardError=inherit
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
# SQLite writes temporary files (large deletes, sorts); strict makes the shared /tmp read-only.
PrivateTmp=yes
ReadWritePaths=/srv/corpus/books /var/lib/corpus-mcp
