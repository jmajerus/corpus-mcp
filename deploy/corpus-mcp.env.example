# /etc/corpus-mcp/env
CORPUS_SOURCE=corpus-sync@calibre-web.localdomain
CORPUS_BOOKS_ROOT=/srv/corpus/books
CORPUS_LIBRARIES=main
# Books with any of these Calibre tags are never indexed.
CORPUS_EXCLUDE_TAGS=private
CORPUS_DB=/var/lib/corpus-mcp/corpus.db
CORPUS_SSH_KEY=/var/lib/corpus-mcp/.ssh/id_ed25519
CORPUS_HOST=0.0.0.0
CORPUS_PORT=8000
