# /etc/corpus-mcp/env
CORPUS_SOURCE=corpus-sync@calibre-web.localdomain
CORPUS_BOOKS_ROOT=/srv/corpus/books
CORPUS_LIBRARIES=main
# Books with any of these Calibre tags are never indexed.
CORPUS_EXCLUDE_TAGS=private
CORPUS_DB=/var/lib/corpus-mcp/corpus.db
CORPUS_SSH_KEY=/var/lib/corpus-mcp/.ssh/id_ed25519
# /admin and /review writes require a Cloudflare Access token for the corpus application.
# Without both values every write is refused. The audience is the application's AUD tag.
CORPUS_ACCESS_TEAM_DOMAIN=https://linkbud.cloudflareaccess.com
CORPUS_ACCESS_AUD=
# The vocabulary intake (POST /api/intake/vocabulary) accepts only this Access service token: its client
# id and the audience of the intake's own Access application. npm run deploy copies both from .env.
# CORPUS_VOCABULARY_PUSH_CLIENT_ID=
# CORPUS_VOCABULARY_PUSH_AUD=
CORPUS_HOST=0.0.0.0
CORPUS_PORT=8000
# Primary data (pinned citekeys): never rebuilt; corpus-backup.timer copies it nightly.
CORPUS_DATA_DB=/var/lib/corpus-mcp/data.db
# Calibre-Web's public shelves, fetched by corpus-sync.sh; they belong to the library Calibre-Web serves.
CORPUS_SHELVES_FILE=/var/lib/corpus-mcp/shelves.json
CORPUS_SHELVES_LIBRARY=main
CORPUS_BACKUP_DIR=/var/lib/corpus-mcp/backups

# Zotero (read-only mirror, src/zotero.ts). Off until an API key is set. Make a key with
# read-only library access at https://www.zotero.org/settings/keys; the same page shows the
# user id. A group library is "groups/<group id>".
# CORPUS_ZOTERO_LIBRARY=users/1234567
# CORPUS_ZOTERO_API_KEY=
# CORPUS_ZOTERO_INTERVAL_MINUTES=30

# The public catalogue (src/public/; see PLAN.md "Public catalogue"). Off by default. With "catalogue",
# the server rebuilds public.db every CORPUS_PUBLISH_INTERVAL_MINUTES and serves it at / on CORPUS_PORT
# and, if set, on CORPUS_PUBLIC_PORT, which serves nothing else. Book text and page images are never in it.
# CORPUS_PUBLIC=catalogue
# CORPUS_PUBLIC_DB=/var/lib/corpus-mcp/public.db
# CORPUS_PUBLIC_PORT=8001
# CORPUS_PUBLIC_TITLE=Library
# CORPUS_PUBLIC_URL=https://library.example.org
# Other public sites (comma-separated base URLs) whose key lists link their pages to these books.
# CORPUS_SITE_LINKS=https://quotes.example.org
# CORPUS_PUBLISH_INTERVAL_MINUTES=10
